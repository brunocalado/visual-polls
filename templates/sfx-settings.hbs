<div class="vp-sfx-settings">

  <section class="vp-sfx-section">
    <h3 class="vp-sfx-section-label">
      <i class="fa-solid fa-volume-high"></i>
      {{localize "VISUAL_POLLS.SFX.VolumeLabel"}}
    </h3>
    <div class="vp-sfx-volume-row">
      <input type="range" class="vp-sfx-volume" min="0" max="1" step="0.01" value="{{volume}}" />
      <span class="vp-sfx-volume-value">{{volumePercent}}%</span>
    </div>
  </section>

  <section class="vp-sfx-section">
    <h3 class="vp-sfx-section-label">
      <i class="fa-solid fa-music"></i>
      {{localize "VISUAL_POLLS.SFX.SoundsLabel"}}
    </h3>
    {{#each sounds}}
    {{#if groupLabel}}
    <p class="vp-sfx-group-label">{{localize groupLabel}}</p>
    {{/if}}
    <div class="vp-sfx-sound-row">
      <label class="vp-sfx-toggle">
        <input type="checkbox" data-enabled-field="{{enabledField}}" {{#if enabled}}checked{{/if}} />
        <span class="vp-sfx-sound-name">{{localize label}}</span>
      </label>
      <div class="vp-sfx-path-row">
        <input type="text" class="vp-sfx-path-input" data-path-field="{{pathField}}" value="{{path}}" />
        <button type="button" class="vp-sfx-icon-btn" data-action="pickFile" data-path-field="{{pathField}}" title="{{localize "VISUAL_POLLS.SFX.Browse"}}">
          <i class="fa-solid fa-folder-open"></i>
        </button>
        <button type="button" class="vp-sfx-icon-btn" data-action="resetPath" data-path-field="{{pathField}}" data-default-path="{{defaultPath}}" title="{{localize "VISUAL_POLLS.SFX.Reset"}}">
          <i class="fa-solid fa-rotate-left"></i>
        </button>
      </div>
    </div>
    {{/each}}
  </section>

  <footer class="vp-sfx-footer">
    <button type="button" class="vp-primary" data-action="save">
      <i class="fa-solid fa-floppy-disk"></i> {{localize "VISUAL_POLLS.SFX.Save"}}
    </button>
  </footer>

</div>
